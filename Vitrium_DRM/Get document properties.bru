meta {
  name: Get document properties
  type: http
  seq: 3
}

get {
  url: https://api.protectedpdf.com/api/2.0/Version/GetByExternalKey/test123
  body: json
  auth: inherit
}

headers {
  X-VITR-SESSION-TOKEN: {{SessionToken}}
  Content-Type: application/json
  Accept: application/json
  X-VITR-ACCOUNT-TOKEN: {{VITR_ACCOUNT_TOKEN}}
}

settings {
  encodeUrl: true
}
